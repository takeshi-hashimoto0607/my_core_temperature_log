<% content_for(:title, t(".title")) %>

<div class="container py-5">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1><%= t(".title") %></h1>

      <%= form_with url: login_path, data: { turbo: false } do |f| %>
        <div class="mb-3">
          <%= f.label :name, User.human_attribute_name(:name) %>
          <%= f.text_field :name, class: "form-control", autocomplete: "username", autofocus: true %>
        </div>

        <div class="mb-3">
          <%= f.label :password, User.human_attribute_name(:password) %>
          <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
        </div>

        <%= f.submit t(".login"), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
