<% content_for(:title, t(".title")) %>

<div class="print-page">
  <div class="d-print-none mb-4">
    <%= link_to t(".back_to_list"), temperature_records_path(date: @date), class: "btn btn-outline-secondary" %>
    <button type="button" class="btn btn-primary" onclick="window.print()"><%= t(".print") %></button>
  </div>

  <h1><%= t(".title") %></h1>
  <p><%= l @date, format: :long %></p>

  <% if @temperature_records.present? %>
    <table class="table print-table">
      <thead>
        <tr>
          <th><%= TemperatureRecord.human_attribute_name(:menu) %></th>
          <th><%= TemperatureRecord.human_attribute_name(:set_id) %></th>
          <th><%= TemperatureRecord.human_attribute_name(:position) %></th>
          <th><%= TemperatureRecord.human_attribute_name(:temperature) %></th>
          <th><%= TemperatureRecord.human_attribute_name(:measured_at) %></th>
          <th><%= TemperatureRecord.human_attribute_name(:user) %></th>
        </tr>
      </thead>
      <tbody>
        <% @temperature_records.each do |record| %>
          <tr>
            <td><%= record.menu.name %></td>
            <td><%= t("temperature_records.new.set_label", set_id: record.set_id) %></td>
            <td><%= t("temperature_records.new.position_label", position: record.position) %></td>
            <td><%= record.temperature %></td>
            <td><%= l record.measured_at, format: :short %></td>
            <td><%= record.user.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t(".no_result") %></p>
  <% end %>
</div>
